# Copy this file to .dev.vars for local `wrangler dev`
# Non-secret variables
ALLOWED_ORIGINS="http://localhost:3001"
RATE_LIMIT_MAX="100"
RATE_LIMIT_WINDOW_MS="60000"
NODE_ENV="development"
PUBLIC_BASE_URL="http://localhost:3001"
# Override these when the passkey origin/RP differs from PUBLIC_BASE_URL.
PASSKEY_ORIGIN="http://localhost:3001"
PASSKEY_RP_ID="localhost"
REQUIRE_CLIENT_SECRET=false
RATE_LIMIT_ENABLED=false
CLIENT_SECRET_BYPASS="/api/auth/register,/api/auth/login,/api/auth/passkey,/api/application/verify-client-secret,/api/auth/:provider,/api/auth/:provider/callback,/api/auth/providers,/api/auth/config,/api/auth/me,/api/auth/logout,/api/system/version,/api/tool-outputs/converter/published/:publishId"
TOOL_OUTPUT_REQUIRE_HTTPS=false

# optional for OAuth, if you do not need oauth login, remove them from cloudflare envs
# better to put secret variables to secrets
GITHUB_CLIENT_ID=your_github_client_secret
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=http://localhost:3001/api/auth/github/callback

LINUXDO_CLIENT_ID=your_linuxdo_client_secret
LINUXDO_CLIENT_SECRET=your_linuxdo_client_secret
LINUXDO_CALLBACK_URL=http://localhost:3001/api/auth/linuxdo/callback
LINUXDO_AUTHORIZATION_URL=https://connect.linux.do/oauth2/authorize
LINUXDO_TOKEN_URL=https://connect.linux.do/oauth2/token
LINUXDO_PROFILE_URL=https://connect.linux.do/api/user
LINUXDO_SCOPE=profile,email

# Stripe creator support checkout
STRIPE_SUPPORT_CREATOR_NAME=Your Name
STRIPE_SUPPORT_BASE_URL=http://localhost:3001
STRIPE_SUPPORT_SUCCESS_URL=
STRIPE_SUPPORT_CANCEL_URL=

# Optional image upload proxy target for /api/images/upload when using workers backend
# Example: IMAGE_SERVICE_URL=http://127.0.0.1:8788
IMAGE_SERVICE_URL=

# System version / Git metadata (optional)
SERVER_COMMIT_ID=
GIT_REPO_SLUG=MARVElOUS-DEV/doggy-nav
SYSTEM_VERSION_ENABLED=true
GITHUB_TOKEN=

# D1 database config should be configured in cloudflare workers dashboard binding.

# Do NOT put secrets here. Set secrets with:
#   wrangler secret put JWT_SECRET
#   wrangler secret put GITHUB_CLIENT_SECRET
#   wrangler secret put LINUXDO_CLIENT_SECRET
#   wrangler secret put STRIPE_SECRET_KEY
