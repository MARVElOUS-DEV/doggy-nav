## Doggy Nav Admin (Umi) Environment Example
PORT=3000
# Client secret to include on API requests from the admin UI
# UMI_APP_ prefixed envs can be accessed at client side.
DOGGY_SERVER_CLIENT_SECRET=replace-with-your-client-secret
DOGGY_SERVER=http://localhost:3002
UMI_APP_COPY_RIGHT_TEXT=2026 狗狗导航
# Optional: Standalone image service URL (if using doggy-nav-image-service)
# Leave empty to keep using the main backend's /api/images/upload endpoint
UMI_APP_IMAGE_SERVICE_URL=
