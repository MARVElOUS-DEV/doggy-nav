# Example .env for docker-compose (production or local)
# Copy to .env and set appropriate values before running:
#   docker compose -f deploy/docker-compose-prod.yml --env-file deploy/.env up -d

# Container registry (defaults work for public images published by CI)
IMAGE_REGISTRY=ghcr.io
IMAGE_NAMESPACE=MARVElOUS-DEV
# Pin to a specific release tag/sha in production
IMAGE_TAG=latest

# Backend security and limits
# REQUIRED: Use a strong secret (>=32 chars)
JWT_SECRET=change-me-please-32chars-minimum
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# CORS: comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:3001,http://localhost:8080
# Passkeys must match the public HTTPS frontend origin exactly.
PASSKEY_RP_ID=your-domain.example
PASSKEY_ORIGIN=https://your-domain.example

# MongoDB connection override (optional)
# For non-SRV URIs, pass host:port only; the server will expand to mongodb://host:port/navigation
# For Atlas/SRV, provide full mongodb+srv:// URL and it will be used as-is
# MONGO_URL=mongodb:27017

# Admin -> Server proxy client secret (optional; required if server enforces client secret)
# DOGGY_SERVER_CLIENT_SECRET=

# Backend Stripe checkout support for creator payments
# Set these on the runtime that serves the API (server or workers)
STRIPE_SECRET_KEY=sk_live_replace_with_your_personal_stripe_secret_key
STRIPE_SUPPORT_CREATOR_NAME=Your Name
STRIPE_SUPPORT_BASE_URL=https://your-domain.example
STRIPE_SUPPORT_SUCCESS_URL=
STRIPE_SUPPORT_CANCEL_URL=

# Node environment
NODE_ENV=production
EGG_SERVER_ENV=prod
