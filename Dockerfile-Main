# Multi-stage build for doggy-nav-main (Next.js Frontend)
FROM node:24-alpine AS base

# Install pnpm via Corepack
RUN corepack enable && corepack prepare pnpm@10.28.2 --activate

# Install dependencies only when needed
FROM base AS builder
WORKDIR /app

# Copy package.json and lock files
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.json ./
COPY packages/doggy-nav-main ./packages/doggy-nav-main
COPY packages/doggy-nav-server/package.json ./packages/doggy-nav-server/
COPY packages/doggy-nav-admin/package.json ./packages/doggy-nav-admin/
COPY packages/doggy-nav-core ./packages/doggy-nav-core

# Install dependencies
RUN pnpm install --frozen-lockfile
# Build the application
ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_ENV=production
ARG NEXT_PUBLIC_IMAGE_SERVICE_URL=
ENV NEXT_PUBLIC_IMAGE_SERVICE_URL=${NEXT_PUBLIC_IMAGE_SERVICE_URL}
RUN pnpm -F doggy-nav-core build && pnpm -F doggy-nav-main build

# Install production dependencies only
FROM base AS prod-deps
WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/doggy-nav-main/package.json ./packages/doggy-nav-main/
COPY packages/doggy-nav-core/package.json ./packages/doggy-nav-core/
ENV CI=true
# Core is compiled in the builder; its TypeScript prepare hook needs dev dependencies.
RUN pnpm install --prod --frozen-lockfile --ignore-scripts

# Production image, copy all the files and run Next.js
FROM base AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

# Create a non-root user
RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nextjs

# Copy built application
COPY --from=builder --chown=nextjs:nodejs /app/packages/doggy-nav-main/dist ./packages/doggy-nav-main/dist
COPY --from=builder /app/packages/doggy-nav-main/public ./packages/doggy-nav-main/public
COPY --from=builder /app/packages/doggy-nav-main/next.config.ts ./packages/doggy-nav-main/
COPY --from=builder /app/packages/doggy-nav-main/package.json ./packages/doggy-nav-main/
COPY --from=prod-deps /app/node_modules ./node_modules
COPY --from=prod-deps /app/packages/doggy-nav-main/node_modules ./packages/doggy-nav-main/node_modules
COPY --from=builder /app/packages/doggy-nav-core/package.json ./packages/doggy-nav-core/
COPY --from=builder /app/packages/doggy-nav-core/dist ./packages/doggy-nav-core/dist

USER nextjs

EXPOSE 3001

ENV PORT=3001
ENV HOSTNAME="0.0.0.0"

WORKDIR /app/packages/doggy-nav-main
CMD ["pnpm", "exec", "next", "start"]
